# ---- 构建产物（体积大、可重建）----
android/app/build/
android/.gradle/
android/build/
android/_pnpmfix/
*.apk
*.aab

# ---- 签名与口令：★ 绝不进版本库 ----
android/keystore/
android/gradle.properties
android/local.properties
android/build.local.cmd
*.jks
*.keystore

# ---- 容器载荷（单文件 392 MB，走 Release 附件 / 网盘）----
android/app/src/main/assets/rootfs.gz.bin
android/app/src/main/assets/pnpm-incr.gz.bin
*.gz.bin

# ---- 台账与本机工作残留（含手机序列号、本机绝对路径）----
.dsh-ledger.json
LEDGER.md
DECISIONS.md
GOALS.md
JOURNAL.md
_ledger-archive/
_stash/
_handoff/

# ---- 截图与临时验证文件 ----
*.png
*.tgz

# ---- 日志 ----
*.log
android/tools/fix-props.js
# ---- 本机工作残留（发布草稿 / 勘察报告 / 第三方源码留档）----
_rel.md
_release_notes.md
_手机优化报告.md
_research/
_*.sh
_*.cjs
_*.txt
_*.js
# ---- assets 里的备份文件：Gradle 会把 assets 目录整个打进 APK ----
#      （.gitignore 管不到 APK 打包，所以这条只是双保险；物理上别放这儿）
android/app/src/main/assets/*.bak-*
android/app/src/main/assets/*.tmp
# ---- 手机端报告（本机材料，不入库）----
_手机报告-*/
# ---- 临时测试页与探针脚本 ----
_wv*.html
t-*.cjs
_rel*.md

# ---- 活动日志（本机采集产物，按周分桶；不进版本库）----
_ledger-log/
