<?xml version="1.0" encoding="utf-8"?>
<!-- ★ 2026-10-20：启动页改为**浅色**（用户：「启动页面改浅色的吧，深色的不好看」）。
     配色对齐官方 web 前端的浅色主题：
       背景 #FFFFFF / 主文字 #1A1A1A / 次要 #6B7280 / 进度条用官方品牌蓝 #4D6BFE
     ★ 鲸鱼图标用官方 favicon 的矢量路径（ic_whale.xml），黑色填充在浅底上清晰。

     ★★★ 2026-10-20（修「7~8 秒黑屏」）：
     原来是 LinearLayout 竖排，splash 与 webWrap 是**兄弟节点**——
     只要 splash 占满全屏，webWrap 就被挤到屏幕下方之外。
     想让启动页「压在上面」直到页面真的开始画，必须是**叠层（FrameLayout）**：
       WebView 先就位、在底层；splash 覆盖在上层；reveal 时只把 splash 设 GONE。
     为什么必须这样：实测 showWeb → onPageStarted 之间要 8~9 秒
     （WebView 渲染进程冷启动），旧顺序先把 splash 撤了 ⇒ 这 8~9 秒全黑。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFFFF"
    android:fitsSystemWindows="true">

    <!-- 主界面：WebView（★ 底层，从一开始就 VISIBLE，让渲染进程尽早开始初始化） -->
    <FrameLayout
        android:id="@+id/webWrap"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- 启动 / 解压进度页（★ 覆盖在 WebView 之上，直到页面真的开始加载） -->
    <LinearLayout
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:background="#FFFFFFFF">

        <!-- 官方鲸鱼图标 -->
        <ImageView
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:src="@drawable/ic_whale"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/app_name"
            android:textColor="#FF1A1A1A"
            android:textSize="21sp"
            android:textStyle="bold"
            android:letterSpacing="0.01" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="准备中…"
            android:gravity="center"
            android:textColor="#FF6B7280"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#FF4D6BFE"
            android:progressBackgroundTint="#FFE5E7EB" />

        <TextView
            android:id="@+id/detailText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="#FF9CA3AF"
            android:textSize="12sp" />

        <!-- ★★★ 2026-10-21：两个入口（用户拍板）。
             「不强迫别人同时下载几个 apk」⇒ 终端打进同一个包；
             「启动后并不马上进入主界面」⇒ 这里是选择页，不是自动跳转页。

             ★ 终端按钮**一开始就可点**：终端不依赖 rootfs 解压
               （PtySession.start() 会先检查 isInstalled，没解压好会给出明确提示），
               而 DSH 按钮必须等解压完 —— 所以它先置灰、显示进度文案。

             ★★★ 2026-10-21 用户追加要求（原话）：
               「按钮可以缩小一点，**字不用缩小**，就是这个按钮范围可以缩小一点，
                然后做的**圆润**一点，然后**能看出来这是个按钮**就可以了。」
               ⇒ 高度 52dp→46dp、不再 match_parent 撑满，改成 wrap_content + 左右留白，
                 圆角 26dp（≈ 高度一半，胶囊形），加 1.5dp 描边（"看得出是按钮"）。
               ★ 字号保持 16sp **不动** —— 用户明确说"字不用缩小"。
               ★ 用 background=@drawable/btn_pill（shape selector）+ textColor=@color/btn_pill_text，
                 不用 backgroundTint —— 后者依赖 AppCompat 主题，本 Activity 用平台主题，
                 在部分 ROM 上完全不生效（本项目已踩过）。 -->
        <Button
            android:id="@+id/btnDsh"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginTop="26dp"
            android:minWidth="150dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:enabled="false"
            android:text="进入 DSH"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:background="@drawable/btn_pill"
            android:textColor="@color/btn_pill_text" />

        <Button
            android:id="@+id/btnTerminal"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:minWidth="150dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:enabled="true"
            android:text="打开终端"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:background="@drawable/btn_pill"
            android:textColor="@color/btn_pill_text" />
    </LinearLayout>
</FrameLayout>
